{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "SLTerm",
    "version": "0.19.1",
    "identifier": "dev.salyvn.slterm",
    "build": {
        "frontendDist": "../dist/frontend-tauri"
    },
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "title": "SLTerm",
                "width": 1400,
                "height": 900,
                "minWidth": 900,
                "minHeight": 600,
                "decorations": false,
                "transparent": true,
                "resizable": true,
                "center": true,
                "visible": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "nsis",
            "app",
            "dmg",
            "appimage",
            "deb"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "copyright": "Copyright 2025, Salyvn",
        "category": "DeveloperTool",
        "shortDescription": "Open-Source Modern Terminal by Salyvn",
        "publisher": "Salyvn",
        "resources": {
            "../dist/bin/*": "bin/",
            "../dist/schema/*": "schema/"
        },
        "linux": {
            "deb": {
                "depends": [
                    "libwebkit2gtk-4.1-0",
                    "libgtk-3-0"
                ]
            }
        }
    }
}
