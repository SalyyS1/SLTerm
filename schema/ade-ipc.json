{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slterm:ade:ipc:1",
  "title": "SLTerm private ADE IPC",
  "protocolVersion": 1,
  "maxFrameBytes": 65536,
  "methods": ["hello", "spawn", "input", "resize", "ack", "stop", "shutdown", "preferences.load", "preferences.save.begin", "preferences.save.chunk", "preferences.save.commit", "preferences.save.cancel", "files.list", "files.read", "files.save.begin", "files.save.chunk", "files.save.commit", "files.save.cancel", "transcripts.metadata", "transcripts.read"],
  "hostReservedMethods": ["shutdown"],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "method"],
      "properties": {
        "version": {"type": "integer", "const": 1, "zig": "u32"},
        "id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991, "zig": "u64"},
        "method": {"type": "string", "zig": "[]const u8"},
        "session_id": {"type": "integer", "default": 0, "zig": "u64"},
        "run_id": {"type": ["string", "null"], "default": null, "zig": "?[]const u8"},
        "workspace_id": {"type": ["string", "null"], "default": null, "zig": "?[]const u8"},
        "executable": {"type": ["string", "null"], "default": null, "zig": "?[]const u8"},
        "args": {"type": "array", "items": {"type": "string"}, "default": [], "zig": "[]const []const u8"},
        "cwd": {"type": ["string", "null"], "default": null, "zig": "?[]const u8"},
        "cols": {"type": "integer", "minimum": 1, "maximum": 32767, "default": 100, "zig": "i16"},
        "rows": {"type": "integer", "minimum": 1, "maximum": 32767, "default": 30, "zig": "i16"},
        "data": {"type": ["string", "null"], "default": null, "zig": "?[]const u8"},
        "sequence": {"type": "integer", "default": 0, "zig": "u64"},
        "root": {"type": ["string", "null"], "default": null, "zig": "?[]const u8"},
        "path": {"type": ["string", "null"], "default": null, "zig": "?[]const u8"},
        "offset": {"type": "integer", "default": 0, "zig": "u64"},
        "cursor": {"type": "integer", "default": 0, "zig": "u64"},
        "total_bytes": {"type": "integer", "default": 0, "zig": "u64"},
        "expected_revision": {"type": "integer", "default": 0, "zig": "u64"},
        "if_match": {"type": ["string", "null"], "default": null, "zig": "?[]const u8"},
        "upload_id": {"type": ["string", "null"], "default": null, "zig": "?[]const u8"}
      }
    },
    "response": {
      "type": "object",
      "required": ["version", "id", "ok"],
      "properties": {
        "version": {"const": 1}, "id": {"type": "integer"}, "ok": {"type": "boolean"},
        "error_code": {"type": "string"}, "message": {"type": "string"},
        "result": {"type": "object"}
      },
      "description": "A success carrying data uses result. Failure carries error_code; timeout/EOF is unknown completion and never automatic retry."
    },
    "event": {
      "type": "object",
      "required": ["version", "event"],
      "properties": {
        "version": {"const": 1},
        "event": {"enum": ["ready", "output", "gap", "input-error", "archive-warning", "stream-error", "exit", "transport_error", "transport_closed", "close_requested", "shutdown_started", "shutdown_stalled"]},
        "session_id": {"type": "integer"}, "data": {"type": "string"}, "sequence": {"type": "integer"},
        "last_sequence": {"type": "integer"}, "exit_code": {"type": "integer"},
        "discarded_bytes": {"type": "integer"}, "affected_bytes": {"type": "integer"},
        "error_code": {"type": "string"}, "message": {"type": "string"}
      },
      "description": "Output data is base64 bytes. Monotonic per-session sequence; exit follows all output and identifies last_sequence. No transcript restore implies a running process."
    }
  },
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/response"}, {"$ref": "#/$defs/event"}]
}
